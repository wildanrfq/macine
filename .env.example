DATABASE_URL="file:./dev.db"

# -------------------------------------------------------------
# Duitku Payment Gateway Configuration
# -------------------------------------------------------------
DUITKU_MERCHANT_CODE="Dxxxx"
DUITKU_API_KEY="your_duitku_api_key_here"
DUITKU_IS_PRODUCTION="false"
DUITKU_CALLBACK_URL="https://your-ngrok-domain.ngrok-free.app/api/payment/webhook"
DUITKU_PAYMENT_METHOD="NQ"

# -------------------------------------------------------------
# Google OAuth 2.0 Configuration
# -------------------------------------------------------------
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
